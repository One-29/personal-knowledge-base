# 复制为 .env 并填写（.env 已被 .gitignore 忽略，永不入库）
# 数据库连接：Docker 容器 pgvector/pgvector:pg16（开发环境 trust 免密）
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/knowbase

# 原文文件存储根目录（决策 D6：原文在文件系统，库内只存元数据）
STORAGE_DIR=./data/storage

# 上传大小上限（字节）：10MB
MAX_UPLOAD_BYTES=10485760

# 切分参数（04 DR1；06 评估阶段用网格扫描回调）
CHUNK_MAX_CHARS=800
CHUNK_OVERLAP_CHARS=80

# Embedding 通道（04 DR2）：OpenAI 兼容协议，供应商可配；全项目模型唯一。
# 换模型必须：① 全库重向量化 ② 维度迁移（见 alembic 维度迁移脚本）。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=30
