# 源码运行时复制为 .env；桌面安装包首次启动会复制到用户目录 config.env。
# 两者都只保存在本机并被 Git 忽略，填写后不要上传或分享。
# 日常运行默认使用 SQLite，并把数据库和原文放在操作系统用户数据目录：
# Windows: %LOCALAPPDATA%\KnowBase
# macOS:   ~/Library/Application Support/KnowBase
# Linux:   $XDG_DATA_HOME/knowbase 或 ~/.local/share/knowbase
# 如需整体改位置，只设置这一项；通常不需要配置 DATABASE_URL / STORAGE_DIR。
# KNOWBASE_DATA_DIR=D:/KnowBaseData

# 每进程连接池：模型调用期间释放只读事务；耗尽时最多等待 5 秒
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=5

# PostgreSQL 连接串与 STORAGE_DIR 只供旧数据迁移、兼容测试和高级自托管覆盖；
# 评估脚本会在子进程中使用独立目标，不要把评估路径写进日常 .env。

# 上传大小上限（字节）：10MB
MAX_UPLOAD_BYTES=10485760
# 一期 Markdown 图片包（ZIP）限制：压缩包 50MB、解压后 100MB、最多 200 个条目
MAX_PACKAGE_BYTES=52428800
MAX_PACKAGE_UNCOMPRESSED_BYTES=104857600
MAX_PACKAGE_FILES=200
# 单图不超过 25MB / 4000 万像素；异常压缩比按 ZIP bomb 拒绝
MAX_IMAGE_BYTES=26214400
MAX_IMAGE_PIXELS=40000000
MAX_ZIP_COMPRESSION_RATIO=100

# 切分参数（04 DR1；06 评估阶段用网格扫描回调）
CHUNK_MAX_CHARS=800
CHUNK_OVERLAP_CHARS=80

# PostgreSQL pg_trgm 索引预过滤阈值（SQLite FTS5 不读取此项）
KEYWORD_SIMILARITY_THRESHOLD=0.1

# 服务端硬上限；客户端 max_steps 只能进一步降低
WORKFLOW_MAX_STEPS=5

# Embedding 通道（04 DR2）：OpenAI 兼容协议，供应商可配；全项目模型唯一。
# 服务地址、模型和维度会写入数据库指纹。换任一项前必须全库重向量化；
# 否则问答/入库会拒绝混用旧向量并提示重建。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=30
# 大文档按块分批请求；限流、5xx 与网络故障最多重试 2 次（0.5s、1s）
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=2
EMBEDDING_RETRY_BASE_SECONDS=0.5

# LLM 生成通道；可与 Embedding 使用同一个 SiliconFlow API key
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_TIMEOUT_SECONDS=60
