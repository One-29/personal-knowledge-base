# 复制为 .env 并填写（.env 已被 .gitignore 忽略，永不入库）
# 数据库连接：Ubuntu WSL2 中的 pgvector/pgvector:pg16（本机开发密码）
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/knowbase

# 每进程连接池：模型调用期间释放只读事务；耗尽时最多等待 5 秒
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=5

# 原文文件存储根目录（决策 D6：原文在文件系统，库内只存元数据）
STORAGE_DIR=./data/storage
# 评估不要在这里改日常配置；scripts/run-eval.ps1 会在子进程中改用
# knowbase_eval + ./data/eval-storage，并由 eval.run_eval 再做强制校验。

# 上传大小上限（字节）：10MB
MAX_UPLOAD_BYTES=10485760

# 切分参数（04 DR1；06 评估阶段用网格扫描回调）
CHUNK_MAX_CHARS=800
CHUNK_OVERLAP_CHARS=80

# pg_trgm 索引预过滤阈值（0 < 值 <= 1）；短词/长块召回需配合真实语料评估
KEYWORD_SIMILARITY_THRESHOLD=0.1

# 服务端硬上限；客户端 max_steps 只能进一步降低
WORKFLOW_MAX_STEPS=5

# Embedding 通道（04 DR2）：OpenAI 兼容协议，供应商可配；全项目模型唯一。
# 换模型必须：① 全库重向量化 ② 维度迁移（见 alembic 维度迁移脚本）。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=30
